<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pageBackgroundColor"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="64dp">

        <TextView
            android:id="@+id/appName"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/primaryColor"
            tools:text="Instagram" />

        <TextView
            android:id="@+id/offList"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="Not part of Work AM · bypass 2 in this block" />

        <TextView
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/friction_reason_label" />

        <EditText
            android:id="@+id/reason"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_outline"
            android:hint="@string/friction_reason_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="2"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:textColorHint="?attr/primaryColorTrans50" />

        <TextView
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/friction_limit_label" />

        <LinearLayout
            android:id="@+id/limits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/countdown"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            tools:text="Wait 10 s" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/open"
                style="@style/SetupButton"
                android:paddingHorizontal="28dp"
                android:text="@string/friction_open"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/cancel"
                style="@style/SetupButton"
                android:layout_marginStart="12dp"
                android:text="@string/cancel" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
