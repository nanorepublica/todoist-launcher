<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pageBackgroundColor"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="64dp">

        <TextView
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speak"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/status"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="Listening…" />

        <EditText
            android:id="@+id/transcript"
            style="@style/TextMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_outline"
            android:gravity="top"
            android:hint="@string/speak_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:textColorHint="?attr/primaryColorTrans50" />

        <TextView
            android:id="@+id/listen"
            style="@style/SetupButton"
            android:text="@string/speak_listen_again" />

        <TextView
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/speak_send_to" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/toTask"
                style="@style/SetupButton"
                android:text="@string/speak_to_task"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/toClaude"
                style="@style/SetupButton"
                android:layout_marginStart="10dp"
                android:text="@string/speak_to_claude" />

            <TextView
                android:id="@+id/toCopy"
                style="@style/SetupButton"
                android:layout_marginStart="10dp"
                android:text="@string/speak_to_copy" />
        </LinearLayout>

        <TextView
            android:id="@+id/cancel"
            style="@style/SetupButton"
            android:layout_marginTop="28dp"
            android:text="@string/cancel" />
    </LinearLayout>
</ScrollView>
