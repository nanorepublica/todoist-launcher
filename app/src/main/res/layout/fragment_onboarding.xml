<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pageBackgroundColor"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="64dp">

        <TextView
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_title"
            android:textColor="?attr/primaryColor" />

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/onboarding_intro" />

        <!-- Step 1: default launcher -->
        <TextView
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/onboarding_step_default"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/stepDefaultStatus"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_todo" />

        <TextView
            android:id="@+id/stepDefaultAction"
            style="@style/SetupButton"
            android:text="@string/onboarding_set_default" />

        <!-- Step 2: calendar permission -->
        <TextView
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/onboarding_step_permission"
            android:textColor="?attr/primaryColor" />

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_permission_why" />

        <TextView
            android:id="@+id/stepPermissionStatus"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_todo" />

        <TextView
            android:id="@+id/stepPermissionAction"
            style="@style/SetupButton"
            android:text="@string/onboarding_allow_calendar" />

        <!-- Step 3: stage calendar -->
        <TextView
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/onboarding_step_calendar"
            android:textColor="?attr/primaryColor" />

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_calendar_why" />

        <TextView
            android:id="@+id/stepCalendarStatus"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_todo" />

        <TextView
            android:id="@+id/stepCalendarDetail"
            style="@style/TextSmallLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/stepCalendarCreate"
            style="@style/SetupButton"
            android:text="@string/onboarding_create_calendar" />

        <TextView
            android:id="@+id/stepCalendarPick"
            style="@style/SetupButton"
            android:text="@string/onboarding_pick_calendar" />

        <TextView
            android:id="@+id/stepCalendarGoogle"
            style="@style/SetupButton"
            android:text="@string/onboarding_create_google" />

        <!-- Step 4: default schedule -->
        <TextView
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/onboarding_step_schedule"
            android:textColor="?attr/primaryColor" />

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_schedule_why" />

        <TextView
            android:id="@+id/stepScheduleList"
            style="@style/TextSmallLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/stepScheduleStatus"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_todo" />

        <TextView
            android:id="@+id/stepScheduleAction"
            style="@style/SetupButton"
            android:text="@string/onboarding_add_schedule" />

        <!-- Step 5: Todoist -->
        <TextView
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/onboarding_step_todoist"
            android:textColor="?attr/primaryColor" />

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_todoist_why" />

        <TextView
            style="@style/TextSmallLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/todoist_labels_note" />

        <EditText
            android:id="@+id/todoistToken"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_outline"
            android:hint="@string/todoist_token_hint"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:maxLines="1"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:textColorHint="?attr/primaryColorTrans50" />

        <TextView
            android:id="@+id/stepTodoistStatus"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/todoist_status_none" />

        <TextView
            android:id="@+id/todoistSave"
            style="@style/SetupButton"
            android:text="@string/todoist_save" />

        <TextView
            android:id="@+id/todoistOpenSettings"
            style="@style/SetupButton"
            android:text="@string/todoist_open_settings" />

        <TextView
            android:id="@+id/todoistForget"
            style="@style/SetupButton"
            android:text="@string/todoist_forget" />

        <!-- Step 6: time's up enforcement -->
        <TextView
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/onboarding_step_enforce"
            android:textColor="?attr/primaryColor" />

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_enforce_why" />

        <TextView
            android:id="@+id/stepEnforceStatus"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/onboarding_enforce_off" />

        <TextView
            android:id="@+id/enforceAccessibility"
            style="@style/SetupButton"
            android:text="@string/onboarding_open_accessibility" />

        <TextView
            android:id="@+id/stepNotifyStatus"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/onboarding_notifications_off" />

        <TextView
            android:id="@+id/enforceNotifications"
            style="@style/SetupButton"
            android:text="@string/onboarding_allow_notifications" />

        <!-- Step 7: voice -->
        <TextView
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/onboarding_step_voice"
            android:textColor="?attr/primaryColor" />

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_voice_why" />

        <TextView
            android:id="@+id/stepMicStatus"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/onboarding_mic_off" />

        <TextView
            android:id="@+id/voiceAllowMic"
            style="@style/SetupButton"
            android:text="@string/onboarding_allow_mic" />

        <TextView
            android:id="@+id/stepVoiceChecks"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/voiceSpeechSettings"
            style="@style/SetupButton"
            android:text="@string/onboarding_open_speech_settings" />

        <TextView
            android:id="@+id/finish"
            style="@style/SetupButton"
            android:layout_marginTop="40dp"
            android:paddingHorizontal="28dp"
            android:text="@string/onboarding_finish"
            android:textColor="?attr/primaryColor" />

    </LinearLayout>
</ScrollView>
